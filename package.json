{
  "name": "gsap-creative-animation-repo",
  "private": true,
  "description": "Development tooling for the gsap-motion Claude Code plugin. packages/cli and packages/eslint-plugin are published to npm, as @mehshekari/gsap-motion and @mehshekari/eslint-plugin-gsap-motion.",
  "license": "MIT",
  "workspaces": [
    "examples/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "freshness": "node scripts/check-freshness.mjs",
    "pack:check": "node packages/cli/scripts/check-pack.mjs",
    "audit:example": "node plugins/gsap-motion/skills/gsap-creative-animation/scripts/audit-gsap.mjs examples/next-app/app plugins/gsap-motion/skills/gsap-creative-animation/template",
    "example:dev": "npm run dev --workspace examples/next-app",
    "example:build": "npm run build --workspace examples/next-app"
  },
  "devDependencies": {
    "@sveltejs/acorn-typescript": "1.0.13",
    "acorn": "8.18.0",
    "esbuild": "0.28.2"
  }
}
